{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["environment", "image", "credentials", "database", "backend", "frontend"],
  "properties": {
    "environment": { "type": "string", "enum": ["dev", "prod"] },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "credentials": {
      "type": "object",
      "required": ["username", "password"],
      "properties": {
        "username": { "type": "string", "minLength": 1 },
        "password": { "type": "string" }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "storage": {
          "type": "object",
          "properties": {
            "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1, "maximum": 5 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1, "maximum": 5 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort"] },
            "nodePort": {
              "anyOf": [
                { "type": "string", "maxLength": 0 },
                { "type": "integer", "minimum": 30000, "maximum": 32767 }
              ]
            }
          }
        },
        "backendUrl": { "type": "string" }
      }
    }
  }
}
